<?xml version="1.0" encoding="UTF-8"?>
<mime-app>
  <type>CORE</type>
  <name>mime</name>
  <appname>mime</appname>
  <version>1.0.0</version>
  <description>MIME type detection and management</description>
  <author>wizardo</author>
  <license>MIT</license>
  <categories>
    <category>utility</category>
  </categories>
  <features>
    <feature name="mime_detection">Automatic MIME type detection</feature>
    <feature name="mime_lookup">MIME type lookup by extension</feature>
    <feature name="ext_lookup">Extension lookup by MIME type</feature>
  </features>
  <ext:dependencies mimetype="application/vnd.wizardo.appinfo+xml">
    <ext:dependency name="com.wizardo.core" version="1.0.0" />
  </ext:dependencies>
  <pasv:permissions mimetype="application/vnd.wizardo.appinfo+xml">
    <pasv:permission name="read" value="true" />
  </pasv:permissions>
</mime-app>