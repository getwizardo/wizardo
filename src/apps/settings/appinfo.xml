<?xml version="1.0" encoding="UTF-8"?>
<mime-app>
  <type>CORE</type>
  <name>settings</name>
  <appname>settings</appname>
  <version>1.0.0</version>
  <description>Application settings and configuration</description>
  <author>wizardo</author>
  <license>MIT</license>
  <categories>
    <category>system</category>
  </categories>
  <features>
    <feature name="app_settings">Application settings</feature>
    <feature name="user_preferences">User preferences</feature>
    <feature name="theme">Theme configuration</feature>
  </features>
  <ext:dependencies mimetype="application/vnd.wizardo.appinfo+xml">
    <ext:dependency name="com.wizardo.core" version="1.0.0" />
  </ext:dependencies>
  <pasv:permissions mimetype="application/vnd.wizardo.appinfo+xml">
    <pasv:permission name="read" value="true" />
    <pasv:permission name="write" value="true" />
  </pasv:permissions>
</mime-app>