<?xml version="1.0" encoding="UTF-8"?>
<mime-app>
  <type>application</type>
  <name>Template Files</name>
  <appname>template</appname>
  <version>1.0.0</version>
  <description>Nextcloud-like file management app for wizardo. Manage files, folders, upload, download, rename, move and delete.</description>
  <author>wizardo</author>
  <license>MIT</license>
  <categories>
    <category>files</category>
    <category>storage</category>
    <category>organization</category>
  </categories>
  <ext:dependencies mimetype="application/vnd.wizardo.appinfo+xml">
    <ext:dependency name="com.wizardo.core" version="1.0.0" />
    <ext:dependency name="com.wizardo.webdav" version="1.0.0" />
    <ext:dependency name="com.wizardo.mime" version="1.0.0" />
  </ext:dependencies>
  <features>
    <feature name="file_management">
      <description>Full file management capabilities</description>
    </feature>
    <feature name="folder_management">
      <description>Create, rename, delete folders</description>
    </feature>
    <feature name="file_upload">
      <description>Upload files to storage</description>
    </feature>
    <feature name="file_download">
      <description>Download files from storage</description>
    </feature>
    <feature name="file_rename">
      <description>Rename files and folders</description>
    </feature>
    <feature name="file_move">
      <description>Move files between folders</description>
    </feature>
    <feature name="file_delete">
      <description>Delete files and folders</description>
    </feature>
  </features>
  <pasv:permissions mimetype="application/vnd.wizardo.appinfo+xml">
    <pasv:permission name="read" value="true" />
    <pasv:permission name="write" value="true" />
    <pasv:permission name="delete" value="true" />
    <pasv:permission name="create" value="true" />
    <pasv:permission name="move" value="true" />
  </pasv:permissions>
</mime-app>